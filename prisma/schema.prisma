generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PATIENT_WITH_CAREGIVER
  CAREGIVER
}

model User {
  id             String    @id @default(cuid())
  phone          String?   @unique
  email          String?   @unique
  role           Role?
  fullName       String?
  birthDate      String? // شمسی، مثل 1370/01/01
  companionPhone String? // شماره همراه (اختیاری)
  onboardedAt    DateTime? // وقتی نقش و اطلاعات کامل شد
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OtpCode {
  id         String    @id @default(cuid())
  identifier String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
}
